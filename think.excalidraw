      "text": "{\n    _id\n    name\n    email\n    passwordHash\n    refreshToken\n    userName\n    refreshTokenHash\n    passwordResetTokenHash\n    passwordResetExpires\n    profile: {\n        bio:\n        caption\n        profilePrivacyOption\n        profilePhoto: {\n            filePath\n            profilePhotoPrivacyOption\n        }\n    }\n}",
