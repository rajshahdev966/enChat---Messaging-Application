{
  "name": "enchat",
  "private": true,
  "scripts": {
    "dev": "concurrently --kill-others --names server,client --prefix-colors yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
